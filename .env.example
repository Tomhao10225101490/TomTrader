# Server-only. Node >=22.13. Never use NEXT_PUBLIC_ for API credentials.
FINNHUB_API_KEY=
# Set only to the latency entitlement documented by your account. Default: unverified.
FINNHUB_FEED_TIER=unverified
# Keyless Yahoo/Eastmoney/Tencent adapters: opt in for local personal research.
# Current user's .env.local enables this mode; no paid account or API key is needed.
# This is not permission for public hosting or data redistribution.
TOMTRADER_DATA_MODE=personal
TOMTRADER_PUBLIC_FEEDS=0
# Synthetic offline mode: permanent DEMO banner; separate data/demo.db.
TOMTRADER_DEMO=0
# Optional: absolute SQLite file path. Default data/tomtrader.db (or demo.db).
# TOMTRADER_DB=/absolute/path/to/tomtrader.db
# TOMTRADER_DATA_DIR=/absolute/path/to/data
